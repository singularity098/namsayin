+    // Handles pending window events (and the redraws they ask for) without the UI's idle work, so a redraw's own
+    // X11 traffic can't keep waking it. Events that Xlib queued while drawing are handled too, for up to 8 ms, so a
+    // slow redraw can't hold up the host's GUI thread.
+    void plugin_events()
+    {
+        DISTRHO_SAFE_ASSERT_RETURN(ui != nullptr,);
+        const uint32_t start = d_gettime_ms();
+        do {
+            uiData->app.idle();
+        } while (uiData->app.hasQueuedX11Events() && d_gettime_ms() - start < 8);
+    }
+   #endif
