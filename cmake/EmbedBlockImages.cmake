#
# Writes BlockImages.cpp: every WebP in resources/blocks/ (and thumbs/) as a byte array, by typeId (the file name).
# Run at build time (cmake -DSOURCE=<resources/blocks> -DOUT=<file> -P EmbedBlockImages.cmake), so the images are
# committed only as WebPs; tools/prepare_block_image.py makes them.

file(GLOB images RELATIVE "${SOURCE}" "${SOURCE}/*.webp")
list(SORT images)

set(arrays "")
set(full_lookup "")
set(thumb_lookup "")
foreach(image IN LISTS images)
  get_filename_component(type_id "${image}" NAME_WLE)
  string(MAKE_C_IDENTIFIER "${type_id}" name)
  foreach(kind IN ITEMS full thumb)
    if(kind STREQUAL "full")
      set(path "${SOURCE}/${image}")
    else()
      set(path "${SOURCE}/thumbs/${image}")
      if(NOT EXISTS "${path}")
        continue()
      endif()
    endif()
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    # a line break every 32 bytes keeps the lines short
    string(REGEX REPLACE "((0x..,){32})" "\\1\n    " hex "${hex}")
    string(APPEND arrays "const unsigned char k_${name}_${kind}[] = {\n    ${hex}\n};\n\n")
    string(APPEND ${kind}_lookup "    if (std::strcmp(typeId, \"${type_id}\") == 0)\n        return { k_${name}_${kind}, sizeof(k_${name}_${kind}) };\n")
  endforeach()
endforeach()

set(content "// Generated by cmake/EmbedBlockImages.cmake from resources/blocks/ - do not edit.

#include \"ui/BlockImages.hpp\"

#include <cstring>

namespace namsayin {

namespace {

${arrays}} // namespace

BuiltinImage builtinBlockImage([[maybe_unused]] const char* typeId)
{
${full_lookup}    return { nullptr, 0 };
}

BuiltinImage builtinBlockThumb([[maybe_unused]] const char* typeId)
{
${thumb_lookup}    return { nullptr, 0 };
}

} // namespace namsayin
")

# only touch the file when it changes, so a rebuild doesn't recompile it
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${content}")
